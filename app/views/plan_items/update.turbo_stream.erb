<%= turbo_stream.replace @plan_item do %>
  <% if @plan_item.kind == "gratitude" %>
    <%= render partial: "plan_items/gratitude_item", locals: { gratitude_item: @plan_item } %>
  <% else %>
    <%# Priorities show a circled position number that normally comes from the
        collection render counter. Replacing a single row has no counter, so pass
        the item's index in the ordered list to keep the number from blanking out. %>
    <% counter = @priorities.index { |item| item.id == @plan_item.id } if @plan_item.kind == "priority" %>
    <%= render partial: "plan_items/plan_item",
               locals: { plan_item: @plan_item, plan_item_counter: counter } %>
  <% end %>
<% end %>
