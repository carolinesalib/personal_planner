<div data-week-reset-target="modal"
     data-action="click->week-reset#backdropClick"
     style="display:none; position:fixed; inset:0; z-index:60; align-items:center; justify-content:center; background:rgba(26,23,20,0.40); padding:16px;">
  <div style="width:100%; max-width:420px; background:#FBF8F4; border-radius:28px; padding:26px 24px 22px; box-shadow:0 24px 60px rgba(26,23,20,0.34);">
    <div style="width:46px; height:46px; border-radius:14px; background:#F6E4DE; display:flex; align-items:center; justify-content:center;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B5503A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4,7 20,7"></polyline><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"></path><path d="M6 7l1 12.5A1.5 1.5 0 0 0 8.5 21h7a1.5 1.5 0 0 0 1.5-1.5L18 7"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
    </div>
    <div style="font-size:21px; font-weight:900; color:#2D2925; margin-top:16px;">Start this week over?</div>
    <div style="font-size:15px; font-weight:600; color:#8A8076; margin-top:8px; line-height:1.5;">
      Anything already planned for this week will be removed. Pick how you want to start over.
    </div>

    <%= form_tag planner_week_reset_path(date: @monday.iso8601), method: :delete,
        data: { turbo_frame: "_top", week_reset_target: "form" } do %>
      <%= hidden_field_tag :strategy, "", data: { week_reset_target: "strategy" } %>
    <% end %>

    <div style="display:flex; flex-direction:column; gap:10px; margin-top:22px;">
      <% if @can_copy_previous %>
        <button type="button" data-action="click->week-reset#copyPrevious"
                style="height:52px; border-radius:15px; border:none; background:#2D2925; cursor:pointer; font-size:16px; font-weight:800; color:#FBF8F4; font-family:inherit;">
          Copy from last week
        </button>
      <% end %>
      <button type="button" data-action="click->week-reset#startFromScratch"
              style="height:52px; border-radius:15px; border:2px solid #DDD5C9; background:transparent; cursor:pointer; font-size:16px; font-weight:800; color:#2D2925; font-family:inherit;">
        Start from scratch
      </button>
      <button type="button" data-action="click->week-reset#cancel"
              style="height:52px; border-radius:15px; border:none; background:#EFE9E1; cursor:pointer; font-size:16px; font-weight:800; color:#2D2925; font-family:inherit;">
        Keep what I have
      </button>
    </div>
  </div>
</div>
